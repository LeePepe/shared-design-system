{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeDesignKit AI registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "library", "version", "releaseStatus", "releaseUnit", "documents", "capabilities"],
  "properties": {
    "$schema": {"const": "registry.schema.json"},
    "schemaVersion": {"const": 1},
    "library": {"const": "NativeDesignKit"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "releaseStatus": {"enum": ["unreleased", "released"]},
    "releaseUnit": {
      "type": "object", "additionalProperties": false,
      "required": ["ecosystem", "product", "module"],
      "properties": {"ecosystem": {"const": "swiftpm"}, "product": {"const": "NativeDesignKit"}, "module": {"const": "NativeDesignKit"}}
    },
    "documents": {
      "type": "object", "additionalProperties": false,
      "required": ["entry", "usage", "integration", "examples", "compatibility", "migration", "changelog"],
      "properties": {
        "entry": {"const": "README.md"}, "usage": {"const": "USAGE.md"},
        "integration": {"const": "INTEGRATION.md"}, "examples": {"const": "EXAMPLES.md"},
        "compatibility": {"const": "COMPATIBILITY.md"}, "migration": {"const": "MIGRATION.md"},
        "changelog": {"const": "../CHANGELOG.md"}
      }
    },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "symbol", "source", "documentation", "example"],
        "properties": {
          "id": {"const": "native-token-color"},
          "symbol": {"const": "NativeTokenColor.resolve(_:theme:)"},
          "source": {"const": "../Sources/NativeDesignKit/NativeTokenColor.swift"},
          "documentation": {"const": "USAGE.md"},
          "example": {"const": "examples/consumer/Sources/SamplePalette/SamplePalette.swift"}
        }
      }
    }
  }
}
